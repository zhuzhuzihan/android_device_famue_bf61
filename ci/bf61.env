# ci/bf61.env — ci/build.sh 的输入（本地与 GitHub Actions 共用）
# 所有值都是显式的：脚本不猜设备、不猜镜像形态。

# 设备树在 AOSP 源码树里的路径
DEVICE=bf61
DEVICE_TREE_PATH=device/famue/bf61

# TWRP minimal manifest
TWRP_MANIFEST=https://github.com/minimal-manifest-twrp/platform_manifest_twrp_aosp.git
TWRP_BRANCH=twrp-12.1

# lunch / 构建目标：本机 recovery-as-boot，产物是 boot.img，没有 recoveryimage
LUNCH_TARGET=twrp_bf61-eng
BUILD_TARGET=bootimage

# 并行度：auto = min(nproc, (RAM+swap)/4)；也可显式 JOBS=4
JOBS=auto
NINJA_HIGHMEM_NUM_JOBS=2

# 源码树 / 产物
SRC=${SRC:-$HOME/twrp-src}

# 设备树来源：
#   CI 里由 workflow 导出 DEVICE_TREE_SRC=$GITHUB_WORKSPACE（构建被推送的 commit）
#   本地留空则按 DEVICE_TREE_URL / DEVICE_TREE_BRANCH 浅克隆
DEVICE_TREE_SRC=${DEVICE_TREE_SRC:-}
DEVICE_TREE_URL=${DEVICE_TREE_URL:-https://github.com/zhuzhuzihan/android_device_famue_bf61}
DEVICE_TREE_BRANCH=${DEVICE_TREE_BRANCH:-main}

# 自检脚本（相对设备树根）
CHECK_TREE_SCRIPT=tools/check-tree.sh

# 同步后删 .repo 腾磁盘（CI 推荐 1；本地想继续 repo sync 就设 0）
RECLAIM_DOT_REPO=1
# 构建前最低可用磁盘（GB）
MIN_FREE_GB=18
