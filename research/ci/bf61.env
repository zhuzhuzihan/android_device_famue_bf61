# =============================================================================
# BF61 (Famue BF61, MT6762 / MT6765 BSP tree) — build env for ci/build.sh
#
# Sourced by research/ci/build.sh (final location: devices/bf61.env or ci/bf61.env).
# Every value here is explicit on purpose: the script must not guess anything
# about the device, the image layout or the runner.
# Keep it POSIX-assignment only (no arrays, no $() at source time is fine).
# =============================================================================

# ---------- device identity / path inside the AOSP tree ----------------------
DEVICE=bf61
VENDOR=famue
DEVICE_TREE_PATH=device/famue/bf61

# ---------- TWRP source (minimal manifest) -----------------------------------
TWRP_MANIFEST=https://github.com/minimal-manifest-twrp/platform_manifest_twrp_aosp.git
TWRP_BRANCH=twrp-12.1

# ---------- build shape ------------------------------------------------------
# lunch target: must be listed in AndroidProducts.mk COMMON_LUNCH_CHOICES
LUNCH_TARGET=twrp_bf61-eng
# BOARD_USES_RECOVERY_AS_BOOT := true  =>  no recovery partition, boot.img carries
# the recovery ramdisk. There is no recoveryimage target on this device.
BUILD_TARGET=bootimage
ALLOW_MISSING_DEPENDENCIES=true

# ---------- device tree provenance ------------------------------------------
# CI: the workflow exports DEVICE_TREE_SRC=$GITHUB_WORKSPACE and
#     DEVICE_TREE_REV=$GITHUB_SHA  -> the pushed commit, not the default branch.
# Local: leave DEVICE_TREE_SRC unset -> the script git-fetches DEVICE_TREE_REV
#     (or DEVICE_TREE_BRANCH when REV is empty) into the source tree.
DEVICE_TREE_URL=https://github.com/zhuzhuzihan/android_device_famue_bf61
DEVICE_TREE_BRANCH=main

# ---------- tree validation gate --------------------------------------------
# Lead-owned gate script, lives at the device-tree repo root.
# A missing script is treated as a broken tree (see SKIP_CHECK_TREE).
CHECK_TREE_SCRIPT=tools/check-tree.sh
SKIP_CHECK_TREE=0

# ---------- resources --------------------------------------------------------
# JOBS=auto -> min(nproc, floor((RAM_gb + swap_gb) / 4)); see plan.md §2.
# On ubuntu-22.04 (4 vCPU / 16 GB + 8 GB swap) that resolves to JOBS=4.
JOBS=auto
# soong reads this (build/soong/ui/build/config.go) to throttle link/packaging
# jobs that eat 6-8 GB each.
NINJA_HIGHMEM_NUM_JOBS=2
# swap is a peak-overflow cushion, not a speed-up. 8 GB = 1.5x RAM effective.
# The workflow lowers this to 4 GB when the freed disk is below 45 GB.
SWAP_GB=8
CCACHE_ENABLE=1
CCACHE_SIZE=5G

# ---------- verification thresholds -----------------------------------------
# BOARD_BOOTIMAGE_PARTITION_SIZE from BoardConfig.mk (32 MiB boot partition).
BOOT_PARTITION_SIZE=33554432
BOOT_HEADER_VERSION=2
BOOT_PAGE_SIZE=2048
# cmdline must survive the mkbootimg round-trip (MTK bootopt is mandatory).
BOOT_CMDLINE_EXPECT="bootopt=64S3,32N2,64N2"
EXPECT_KERNEL_MAGIC=gzip
# boot.img must not exceed this fraction of the partition (trim ramdisk if hit).
BOOT_SIZE_WARN_RATIO=0.94

# ---------- prebuilt blobs (checked, not regenerated) -----------------------
PREBUILT_KERNEL=prebuilt/kernel
PREBUILT_DTB=prebuilt/dtb.img
PREBUILT_DTBO=prebuilt/dtbo.img

# ---------- disk budget (fail fast instead of dying 2 h in) -----------------
# clean runner: ~14 GB free of ~70 GB; the workflow's cleanup frees ~30-35 GB.
MIN_FREE_GB_BEFORE_SYNC=40
MIN_FREE_GB_AFTER_SYNC=14
MIN_FREE_GB_BEFORE_BUILD=12
# reclaim .repo/project-objects (git objects, ~8-10 GB) when space gets tight
RECLAIM_DOT_REPO=1

# ---------- misc -------------------------------------------------------------
# WORK default is $PWD/work; the workflow pins it to $GITHUB_WORKSPACE/work.
# SRC default is $WORK/src.
# CCACHE_DIR default is $WORK/.ccache.
