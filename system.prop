# device/famue/bf61/system.prop
# 由 TARGET_SYSTEM_PROP 合并进 recovery ramdisk 的 prop.default。

# 平台 / 动态分区
ro.board.platform=mt6765
ro.boot.dynamic_partitions=true

# Virtual A/B 补充开关（ro.virtual_ab.enabled=true 由 device.mk 继承
# virtual_ab_ota.mk 提供）。stock recovery prop.default 三项齐全，
# libsnapshot 用它们决定 userspace snapshot / VAB compression 路径。
ro.virtual_ab.compression.enabled=true
ro.virtual_ab.userspace.snapshots.enabled=true

# recovery 里不需要 adb 授权弹窗
ro.adb.secure=0

# FBE / metadata 解密
# gatekeeper 的 SPU 路径在非 QTI 环境下常不可用，强制走软件路径
vendor.gatekeeper.disable_spu=true
# metadata 加密使用 wrapped key（与 fstab 的 metadata_encryption=...wrappedkey_v0 对应）
fbe.metadata.wrappedkey=true
