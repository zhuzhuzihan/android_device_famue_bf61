# TWRP recovery fstab for Famue BF61
# Mirrors stock fstab.mt6762 (first_stage_ramdisk copy), tuned for TWRP 12.1.

# Dynamic partitions (read-only, logical)
system     /system      ext4  ro  wait,avb=vbmeta_system,logical,first_stage_mount,slotselect
system_ext /system_ext  ext4  ro  wait,avb=vbmeta_system,logical,first_stage_mount,slotselect
vendor     /vendor      ext4  ro  wait,avb,logical,first_stage_mount,slotselect
product    /product     ext4  ro  wait,avb,logical,first_stage_mount,slotselect

# Metadata partition (md_udc): holds FBE metadata-encryption keys
/dev/block/by-name/md_udc /metadata ext4 noatime,nosuid,nodev,discard wait,check,formattable,first_stage_mount

# Userdata: FBE v2 + metadata encryption, inline crypto engine
/dev/block/by-name/userdata /data ext4 noatime,nosuid,nodev,noauto_da_alloc,errors=panic,inlinecrypt latemount,wait,check,quota,reservedsize=128M,formattable,resize,,checkpoint=block,fileencryption=aes-256-xts:aes-256-cts:v2,keydirectory=/metadata/vold/metadata_encryption

# MTK vendor partitions
/dev/block/by-name/protect1 /mnt/vendor/protect_f ext4 noatime,nosuid,nodev,noauto_da_alloc,commit=1,nodelalloc wait,check,formattable
/dev/block/by-name/protect2 /mnt/vendor/protect_s ext4 noatime,nosuid,nodev,noauto_da_alloc,commit=1,nodelalloc wait,check,formattable
/dev/block/by-name/nvdata /mnt/vendor/nvdata ext4 noatime,nosuid,nodev,noauto_da_alloc,commit=1,nodelalloc wait,check,formattable
/dev/block/by-name/nvcfg /mnt/vendor/nvcfg ext4 noatime,nosuid,nodev,noauto_da_alloc,commit=1,nodelalloc wait,check,formattable

# Removable storage
/devices/platform/externdevice* auto auto defaults voldmanaged=sdcard1:auto,encryptable=userdata
/devices/platform/mt_usb* auto vfat defaults voldmanaged=usbotg:auto

# Partitions exposed to TWRP UI
/dev/block/by-name/boot /boot emmc defaults slotselect
/dev/block/by-name/super /super emmc ro defaults
/dev/block/by-name/frp /frp emmc ro defaults
/dev/block/by-name/misc /misc emmc defaults defaults
/dev/block/by-name/nvdata /nvdata emmc defaults defaults
/dev/block/by-name/nvcfg /nvcfg emmc defaults defaults
/dev/block/by-name/nvram /nvram emmc ro defaults
/dev/block/by-name/proinfo /proinfo emmc ro defaults
/dev/block/by-name/lk /bootloader emmc ro defaults
/dev/block/by-name/lk2 /bootloader2 emmc ro defaults
/dev/block/by-name/logo /logo emmc ro defaults
/dev/block/by-name/expdb /expdb emmc ro defaults
/dev/block/by-name/seccfg /seccfg emmc ro defaults
/dev/block/by-name/boot_para /boot_para emmc ro defaults
/dev/block/by-name/tee1 /tee1 emmc ro defaults
/dev/block/by-name/tee2 /tee2 emmc ro defaults
/dev/block/by-name/scp1 /scp1 emmc ro defaults
/dev/block/by-name/scp2 /scp2 emmc ro defaults
/dev/block/by-name/sspm_1 /sspm_1 emmc ro defaults
/dev/block/by-name/sspm_2 /sspm_2 emmc ro defaults
/dev/block/by-name/md1img /md1img emmc ro defaults
/dev/block/by-name/md1dsp /md1dsp emmc ro defaults
/dev/block/by-name/md1arm7 /md1arm7 emmc ro defaults
/dev/block/by-name/md3img /md3img emmc ro defaults
/dev/block/by-name/spmfw /spmfw emmc ro defaults
/dev/block/by-name/gz1 /gz1 emmc ro defaults
/dev/block/by-name/gz2 /gz2 emmc ro defaults
